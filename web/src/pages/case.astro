  <script>
    import { gsap } from "gsap";

    const snapshotUrl = `${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}reference-data.json`;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function displayMetric(value: number, format?: string) {
      return format === "percent" ? `${(value * 100).toFixed(2)}%` : String(value);
    }

    fetch(snapshotUrl)
      .then((response) => response.ok ? response.json() : null)
      .then((snapshot) => {
        if (!snapshot) return;
        document.querySelectorAll<HTMLElement>("[data-metric]").forEach((node) => {
          const key = node.dataset.metric;
          if (!key || !(key in snapshot)) return;
          const value = Number(snapshot[key]);
          const finalValue = displayMetric(value, node.dataset.format);
          if (reduceMotion || node.dataset.format === "percent") {
            node.textContent = finalValue;
            return;
          }
          gsap.fromTo(node, { textContent: 0 }, {
            textContent: value,
            duration: 0.8,
            ease: "power1.out",
            snap: { textContent: 1 },
            onUpdate() {
              node.textContent = String(Math.round(Number(node.textContent)));
            },
          });
        });
        const validationRows = document.querySelector("#validation-rows");
        if (validationRows && Array.isArray(snapshot.validation_rows)) {
          validationRows.innerHTML = snapshot.validation_rows.map((row: { transmission: number; fidelity_relative_drop: number; count_rate_relative_drop: number }) => `
            <div class="grid grid-cols-3 gap-4 border-t border-black/10 px-5 py-5 text-[15px]">
              <span>${row.transmission.toFixed(2)}</span>
              <span>${(row.fidelity_relative_drop * 100).toFixed(2)}%</span>
              <span>${(row.count_rate_relative_drop * 100).toFixed(2)}%</span>
            </div>
          `).join("");
        }
      })
      .catch(() => undefined);
  </script>
