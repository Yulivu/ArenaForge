---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="ArenaForge | 验证案例"
  description="ArenaForge 验证案例：在质量约束下简化量子纠缠制备图。"
  active="case"
>
  <main>
    <section class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-[.9fr_1.1fr] md:px-8 md:py-24">
      <div class="reveal self-center">
        <p class="mb-5 text-[14px] font-medium text-forge">验证案例</p>
        <h1 class="text-[46px] font-semibold leading-[1.08] text-ink md:text-[66px]">量子纠缠制备图简化</h1>
        <p class="mt-7 text-[18px] leading-8 text-muted">这个案例把实验图中的连接数视为方案复杂度，在质量门槛不被突破的前提下寻找更简单的制备方案。</p>
      </div>
      <figure class="reveal m-0 border border-black/10 bg-paper p-3">
        <img src={`${base}assets/quantum-optics-case.png`} alt="根据推荐候选的真实连接数据绘制的量子纠缠制备图。" class="block h-auto w-full" width="1440" height="900" />
      </figure>
    </section>

    <section class="border-y border-black/10 bg-paper">
      <div class="mx-auto max-w-7xl px-5 py-14 md:px-8 md:py-20">
        <div class="reveal grid gap-8 md:grid-cols-3">
          <article><p class="text-[13px] font-medium text-forge">研究输入</p><h2 class="mt-4 text-[25px] font-semibold">先把比较规则写清楚</h2><p class="mt-3 text-[15px] leading-7 text-muted">最多 55 条连接；每个损耗点的质量下降不超过 2%；在统一物理模拟环境中评估。</p></article>
          <article><p class="text-[13px] font-medium text-forge">实验编排</p><h2 class="mt-4 text-[25px] font-semibold">用同一套规则比较候选</h2><p class="mt-3 text-[15px] leading-7 text-muted">逐条测试连接影响，加入阈值策略参照，并保留每条候选的运行结果。</p></article>
          <article><p class="text-[13px] font-medium text-forge">结果交付</p><h2 class="mt-4 text-[25px] font-semibold">把结论与过程一起交付</h2><p class="mt-3 text-[15px] leading-7 text-muted">推荐方案、失败边界、独立复核和原始运行文件都可以回查。</p></article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
      <div class="reveal grid gap-12 md:grid-cols-[.9fr_1.1fr]">
        <div>
          <p class="mb-4 text-[14px] font-medium text-forge">为什么选这个问题</p>
          <h2 class="text-[36px] font-semibold leading-tight text-ink md:text-[52px]">更简单的实验图，是否还能保持可接受的质量？</h2>
          <p class="mt-5 text-[17px] leading-8 text-muted">这个问题没有现成的标准榜单。研究者需要自己定义实验资源、损耗条件、质量门槛和什么结果值得保留，随后才能让探索真正开始。</p>
        </div>
        <div class="reveal grid divide-y divide-black/10 border-y border-black/10">
          <article class="grid gap-3 py-5 md:grid-cols-[8rem_1fr]"><p class="text-[13px] font-medium text-forge">目标态</p><p class="text-[16px] leading-7 text-ink">三光子、四维 GHZ 目标态：<code class="font-mono text-[14px]">|000&gt; + |111&gt; + |222&gt; + |333&gt;</code></p></article>
          <article class="grid gap-3 py-5 md:grid-cols-[8rem_1fr]"><p class="text-[13px] font-medium text-forge">资源上限</p><p class="text-[16px] leading-7 text-ink">最多 55 条连接，辅助光子预算固定为 3。</p></article>
          <article class="grid gap-3 py-5 md:grid-cols-[8rem_1fr]"><p class="text-[13px] font-medium text-forge">质量门槛</p><p class="text-[16px] leading-7 text-ink">5 个搜索损耗点上，fidelity 和 count rate 相对基线的下降均不得超过 2%。</p></article>
          <article class="grid gap-3 py-5 md:grid-cols-[8rem_1fr]"><p class="text-[13px] font-medium text-forge">比较对象</p><p class="text-[16px] leading-7 text-ink">规范图、阈值策略和随机扰动同时保留，避免只看一条搜索路径。</p></article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
      <div class="reveal max-w-3xl">
        <p class="mb-4 text-[14px] font-medium text-forge">实际运行</p>
        <h2 class="text-[36px] font-semibold leading-tight text-ink md:text-[52px]">这次探索具体做了什么。</h2>
        <p class="mt-5 text-[17px] leading-8 text-muted">从基线开始，系统逐条测试连接影响，再连续删减、保留失败，并用搜索时没有参与的条件重新复核最终结果。</p>
      </div>
      <div class="reveal mt-12 grid divide-y divide-black/10 border-y border-black/10 md:grid-cols-5 md:divide-x md:divide-y-0">
        <article class="min-h-52 py-7 md:px-5 md:first:pl-0"><p class="text-[12px] text-muted">01 · 基线</p><h3 class="mt-6 text-[19px] font-semibold">先跑规范图</h3><p class="mt-3 text-[14px] leading-6 text-muted">固定目标、预算和质量门槛，得到统一起点。</p></article>
        <article class="min-h-52 py-7 md:px-5"><p class="text-[12px] text-muted">02 · 测试</p><h3 class="mt-6 text-[19px] font-semibold">逐条试连接</h3><p class="mt-3 text-[14px] leading-6 text-muted">测量每条连接带来的变化，形成删减顺序。</p></article>
        <article class="min-h-52 py-7 md:px-5"><p class="text-[12px] text-muted">03 · 搜索</p><h3 class="mt-6 text-[19px] font-semibold">保留有效删减</h3><p class="mt-3 text-[14px] leading-6 text-muted">按反馈继续尝试，保留满足质量要求的候选。</p></article>
        <article class="min-h-52 py-7 md:px-5"><p class="text-[12px] text-muted">04 · 失败</p><h3 class="mt-6 text-[19px] font-semibold">留下边界</h3><p class="mt-3 text-[14px] leading-6 text-muted">越过质量门槛的尝试被拒绝，失败原因也进入记录。</p></article>
        <article class="min-h-52 py-7 md:px-5 md:last:pr-0"><p class="text-[12px] text-muted">05 · 复核</p><h3 class="mt-6 text-[19px] font-semibold">换条件再跑</h3><p class="mt-3 text-[14px] leading-6 text-muted">使用未参与搜索的条件，重新检验推荐候选。</p></article>
      </div>
    </section>

    <section class="border-y border-black/10 bg-paper">
      <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
        <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div class="max-w-2xl"><p class="mb-4 text-[14px] font-medium text-forge">候选空间</p><h2 class="text-[36px] font-semibold leading-tight text-ink md:text-[52px]">11 个候选放在同一张图里比较。</h2></div>
          <p class="max-w-md text-[15px] leading-7 text-muted">横轴越左，实验图越简单；纵轴越低，质量下降越小。左下角是本次协议允许的可行区域。</p>
        </div>
        <figure class="reveal mt-10 m-0 border border-black/10 bg-white p-3">
          <img src={`${base}assets/candidate-landscape.png`} alt="候选方案的连接数与最大质量下降散点图，标出 55 条连接预算和 2% 质量门槛。" class="block h-auto w-full" width="1440" height="900" />
        </figure>
        <div class="reveal mt-8 grid gap-6 md:grid-cols-3">
          <article><h3 class="text-[20px] font-semibold text-ink">49 条连接可行</h3><p class="mt-2 text-[15px] leading-7 text-muted">反馈引导删减进入可行区域，最大质量下降为 1.92%。</p></article>
          <article><h3 class="text-[20px] font-semibold text-ink">48 条连接越界</h3><p class="mt-2 text-[15px] leading-7 text-muted">再删一条后质量下降变为 2.32%，因此被明确拒绝。</p></article>
          <article><h3 class="text-[20px] font-semibold text-ink">第二条策略复现结果</h3><p class="mt-2 text-[15px] leading-7 text-muted">阈值策略也得到相同的 49 条连接结构，作为交叉参照保留。</p></article>
        </div>
      </div>
    </section>

    <section class="bg-ink text-white">
      <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
        <div class="reveal flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div class="max-w-2xl"><p class="mb-4 text-[14px] font-medium text-[#6fd1b4]">运行结果</p><h2 class="text-[38px] font-semibold leading-tight md:text-[56px]">推荐方案把连接数降到 49 条。</h2></div>
          <p class="max-w-md text-[16px] leading-7 text-[#c9c9cd]">推荐结论来自同一协议下的候选比较，随后在搜索外的损耗条件中再次复核。</p>
        </div>
        <div class="reveal mt-12 grid divide-y divide-white/15 border-y border-white/15 sm:grid-cols-2 lg:grid-cols-5 lg:divide-x lg:divide-y-0">
          <article class="py-6 lg:px-5 lg:first:pl-0"><p class="text-[34px] font-semibold" data-metric="candidate_count">11</p><p class="mt-1 text-[13px] text-[#c9c9cd]">比较候选</p></article>
          <article class="py-6 lg:px-5"><p class="text-[34px] font-semibold" data-metric="screened_edge_count">74</p><p class="mt-1 text-[13px] text-[#c9c9cd]">单边测试</p></article>
          <article class="py-6 lg:px-5"><p class="text-[34px] font-semibold" data-metric="accepted_action_count">25</p><p class="mt-1 text-[13px] text-[#c9c9cd]">接受删减</p></article>
          <article class="py-6 lg:px-5"><p class="text-[34px] font-semibold" data-metric="recommended_edges">49</p><p class="mt-1 text-[13px] text-[#c9c9cd]">推荐连接数</p></article>
          <article class="py-6 lg:px-5 lg:last:pr-0"><p class="text-[34px] font-semibold" data-metric="max_validation_drop" data-format="percent">1.80%</p><p class="mt-1 text-[13px] text-[#c9c9cd]">独立复核最大下降</p></article>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
      <div class="reveal grid gap-10 md:grid-cols-[.85fr_1.15fr]">
        <div>
          <p class="mb-4 text-[14px] font-medium text-forge">独立复核</p>
          <h2 class="text-[36px] font-semibold leading-tight text-ink md:text-[50px]">不在搜索里使用的条件，也要重新通过。</h2>
          <p class="mt-5 text-[16px] leading-8 text-muted">最终方案没有直接复用搜索损耗点，而是在 0.98、0.85、0.75 三个新条件下重新评估。最大质量下降为 1.80%，仍在 2% 门槛内。</p>
        </div>
        <div class="reveal overflow-hidden border-y border-black/10">
          <div class="grid grid-cols-3 gap-4 bg-paper px-5 py-4 text-[12px] font-medium text-muted"><span>传输率</span><span>fidelity 下降</span><span>count rate 下降</span></div>
          <div id="validation-rows">
            <div class="grid grid-cols-3 gap-4 border-t border-black/10 px-5 py-5 text-[15px]"><span>0.98</span><span>1.51%</span><span>1.53%</span></div>
            <div class="grid grid-cols-3 gap-4 border-t border-black/10 px-5 py-5 text-[15px]"><span>0.85</span><span>1.51%</span><span>1.61%</span></div>
            <div class="grid grid-cols-3 gap-4 border-t border-black/10 px-5 py-5 text-[15px]"><span>0.75</span><span>1.51%</span><span>1.80%</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
      <div class="reveal flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div><p class="mb-4 text-[14px] font-medium text-forge">候选比较</p><h2 class="text-[36px] font-semibold leading-tight text-ink md:text-[50px]">最后留下什么。</h2></div>
        <p class="max-w-md text-[15px] leading-7 text-muted">推荐、保留和淘汰均由预先声明的预算与质量门槛决定。</p>
      </div>
      <div class="reveal mt-10 overflow-x-auto border-y border-black/10">
        <div class="min-w-[720px]">
          <div class="grid grid-cols-[1.6fr_.7fr_.7fr_1.3fr] gap-4 border-b border-black/10 bg-paper px-5 py-4 text-[12px] font-medium text-muted">
            <span>候选</span><span>结果</span><span>连接数</span><span>判断依据</span>
          </div>
          <div class="grid grid-cols-[1.6fr_.7fr_.7fr_1.3fr] gap-4 border-b border-black/10 px-5 py-5 text-[14px]">
            <span><b class="block text-[15px]">反馈引导删减</b><span class="text-muted">sensitivity_guided_025</span></span><span class="font-medium text-forge">推荐</span><span>49</span><span class="text-muted">通过预算、质量门槛和独立复核。</span>
          </div>
          <div class="grid grid-cols-[1.6fr_.7fr_.7fr_1.3fr] gap-4 border-b border-black/10 px-5 py-5 text-[14px]">
            <span><b class="block text-[15px]">阈值参照</b><span class="text-muted">sparse_threshold_150</span></span><span class="font-medium text-ink">保留</span><span>49</span><span class="text-muted">得到同一可行结构，用于交叉比较。</span>
          </div>
          <div class="grid grid-cols-[1.6fr_.7fr_.7fr_1.3fr] gap-4 border-b border-black/10 px-5 py-5 text-[14px]">
            <span><b class="block text-[15px]">下一次删减</b><span class="text-muted">guided boundary action</span></span><span class="font-medium text-[#b42318]">拒绝</span><span>48</span><span class="text-muted">最大质量下降 2.32%，超过 2% 门槛。</span>
          </div>
          <div class="grid grid-cols-[1.6fr_.7fr_.7fr_1.3fr] gap-4 px-5 py-5 text-[14px]">
            <span><b class="block text-[15px]">随机扰动参照</b><span class="text-muted">random_sign_reference</span></span><span class="font-medium text-[#b42318]">拒绝</span><span>74</span><span class="text-muted">质量信号不满足协议要求。</span>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-black/10 bg-paper">
      <div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-14 md:flex-row md:items-center md:justify-between md:px-8">
        <div class="reveal"><p class="text-[14px] font-medium text-forge">核对原始记录</p><h2 class="mt-2 text-[28px] font-semibold text-ink">搜索轨迹、结果证书和运行文件都在仓库中。</h2></div>
        <div class="reveal flex flex-wrap gap-3">
          <a href="https://github.com/Yulivu/ArenaForge/blob/master/examples/quantum_optics_open_exploration/artifacts/search_trace.json" target="_blank" rel="noreferrer" class="rounded-md border border-black/15 px-4 py-3 text-[14px] font-medium text-ink no-underline hover:bg-white">搜索轨迹</a>
          <a href="https://github.com/Yulivu/ArenaForge/blob/master/examples/quantum_optics_open_exploration/artifacts/problem_certificate.json" target="_blank" rel="noreferrer" class="rounded-md border border-black/15 px-4 py-3 text-[14px] font-medium text-ink no-underline hover:bg-white">结果证书</a>
        </div>
      </div>
    </section>
  </main>
  <script>
    import { gsap } from "gsap";

    const snapshotUrl = `${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}reference-data.json`;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function displayMetric(value: number, format?: string) {
      return format === "percent" ? `${(value * 100).toFixed(2)}%` : String(value);
    }

    fetch(snapshotUrl)
      .then((response) => response.ok ? response.json() : null)
      .then((snapshot) => {
        if (!snapshot) return;
        document.querySelectorAll<HTMLElement>("[data-metric]").forEach((node) => {
          const key = node.dataset.metric;
          if (!key || !(key in snapshot)) return;
          const value = Number(snapshot[key]);
          const finalValue = displayMetric(value, node.dataset.format);
          if (reduceMotion || node.dataset.format === "percent") {
            node.textContent = finalValue;
            return;
          }
          gsap.fromTo(node, { textContent: 0 }, {
            textContent: value,
            duration: 0.8,
            ease: "power1.out",
            snap: { textContent: 1 },
            onUpdate() {
              node.textContent = String(Math.round(Number(node.textContent)));
            },
          });
        });
        const validationRows = document.querySelector("#validation-rows");
        if (validationRows && Array.isArray(snapshot.validation_rows)) {
          validationRows.innerHTML = snapshot.validation_rows.map((row: { transmission: number; fidelity_relative_drop: number; count_rate_relative_drop: number }) => `
            <div class="grid grid-cols-3 gap-4 border-t border-black/10 px-5 py-5 text-[15px]">
              <span>${row.transmission.toFixed(2)}</span>
              <span>${(row.fidelity_relative_drop * 100).toFixed(2)}%</span>
              <span>${(row.count_rate_relative_drop * 100).toFixed(2)}%</span>
            </div>
          `).join("");
        }
      })
      .catch(() => undefined);
  </script>
</Layout>
