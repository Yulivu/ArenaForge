{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/contract_confirmation.schema.json",
  "title": "ArenaForge Contract Confirmation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_path",
    "contract_sha256",
    "approved",
    "confirmed_by",
    "confirmed_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_path": {"type": "string", "minLength": 1},
    "contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved": {"const": true},
    "confirmed_by": {"type": "string", "minLength": 1},
    "confirmed_at": {"type": "number"}
  }
}
