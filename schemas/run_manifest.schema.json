{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/run_manifest.schema.json",
  "title": "ArenaForge Run Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "arena_id", "policy", "policy_seed", "adapter_seed", "artifacts"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "run_id": {"type": "string", "minLength": 1},
    "arena_id": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "enum": ["declared", "random", "adaptive"]},
    "policy_seed": {"type": ["integer", "null"]},
    "adapter_seed": {"type": "integer"},
    "artifacts": {"type": "array", "items": {"type": "object"}}
  }
}
