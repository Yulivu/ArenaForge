{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/ledger_event.schema.json",
  "title": "ArenaForge Ledger Event v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "run_id", "sequence", "event_type", "branch", "payload", "previous_event_hash", "event_hash"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
