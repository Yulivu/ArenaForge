{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/experiment_plan.schema.json",
  "title": "ArenaForge Experiment Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "baseline",
    "candidates",
    "seeds",
    "estimated_runs",
    "budget_gate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "baseline": {"$ref": "#/$defs/hypothesis"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/hypothesis"},
      "minItems": 1
    },
    "seeds": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 1,
      "uniqueItems": true
    },
    "estimated_runs": {"type": "integer", "minimum": 1},
    "budget_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runs", "within_budget"],
      "properties": {
        "max_runs": {"type": "integer", "minimum": 1},
        "within_budget": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "label",
        "claim",
        "train_command",
        "eval_command",
        "is_baseline"
      ],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "train_command": {"type": ["string", "null"]},
        "eval_command": {"type": ["string", "null"]},
        "is_baseline": {"type": "boolean"},
        "code_ref": {"type": ["string", "null"]}
      }
    }
  }
}
