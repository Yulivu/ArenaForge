{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/checkpoint.schema.json",
  "title": "ArenaForge Checkpoint v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "run_id",
    "arena_id",
    "policy",
    "policy_seed",
    "adapter_seed",
    "budget_total",
    "budget_remaining",
    "step",
    "pending_action_ids",
    "available",
    "results",
    "support_ids",
    "conflict_ids",
    "research_state",
    "evidence_graph",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {"const": "paused"},
    "run_id": {"type": "string", "minLength": 1},
    "arena_id": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "enum": ["declared", "random", "adaptive"]},
    "policy_seed": {"type": ["integer", "null"]},
    "adapter_seed": {"type": "integer"},
    "budget_total": {"type": "integer", "minimum": 1},
    "budget_remaining": {"type": "integer", "minimum": 0},
    "step": {"type": "integer", "minimum": 0},
    "pending_action_ids": {"type": "array", "items": {"type": "string"}},
    "available": {"type": "array", "items": {"type": "string"}},
    "results": {"type": "object"},
    "support_ids": {"type": "array", "items": {"type": "string"}},
    "conflict_ids": {"type": "array", "items": {"type": "string"}},
    "research_state": {"const": "research_state.json"},
    "evidence_graph": {"const": "evidence.graph.json"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
