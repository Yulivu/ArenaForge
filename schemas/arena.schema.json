{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/arena.schema.json",
  "title": "ArenaForge Arena Contract v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "arena_id", "title", "domain", "problem", "context", "observations", "actions", "feedback", "discovery_signals", "baselines", "stop_rules", "reproducibility"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "arena_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "problem": {"$ref": "#/$defs/problem"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "challenge_set"],
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "challenge_set": {"type": "string", "minLength": 1}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "schema"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "type": {"const": "observation"},
          "schema": {"type": "string", "minLength": 1}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "preconditions", "inputs", "outputs", "cost"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "kind": {"type": "string", "enum": ["observe", "intervene", "compare", "certify"]},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["budget", "units"],
            "properties": {
              "budget": {"type": "string", "minLength": 1},
              "units": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "feedback": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "applies_to", "evaluator"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evaluator": {"type": "string", "minLength": 1}
        }
      }
    },
    "discovery_signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "kind": {"type": "string", "enum": ["supported", "confounded", "boundary", "inconclusive"]},
          "required_evidence": {"type": "object"}
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "stop_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when", "outcome"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["supported", "confounded", "boundary", "inconclusive"]}
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "budget", "adapter_version", "tool_versions"],
      "properties": {
        "seed": {"type": "integer"},
        "budget": {"type": "integer", "minimum": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "tool_versions": {"type": "object"}
      }
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "objective", "scope", "hypotheses"],
      "properties": {
        "question": {"type": "string", "minLength": 20},
        "objective": {"type": "string", "minLength": 10},
        "scope": {"type": "string", "minLength": 10},
        "hypotheses": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
              "statement": {"type": "string", "minLength": 10}
            }
          }
        }
      }
    }
  }
}
