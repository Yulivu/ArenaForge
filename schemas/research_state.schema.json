{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arenaforge.local/schemas/research_state.schema.json",
  "title": "ArenaForge Research State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "arena_id",
    "question",
    "step",
    "budget_total",
    "budget_remaining",
    "stop_status",
    "stop_reason",
    "active_node_ids",
    "completed_actions",
    "hypotheses",
    "branches"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "arena_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 20},
    "step": {"type": "integer", "minimum": 0},
    "budget_total": {"type": "integer", "minimum": 1},
    "budget_remaining": {"type": "integer", "minimum": 0},
    "stop_status": {"type": "string", "enum": ["running", "stopped"]},
    "stop_reason": {"type": ["string", "null"]},
    "active_node_ids": {"type": "array", "items": {"type": "string"}},
    "completed_actions": {"type": "array", "items": {"type": "string"}},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "parent_id",
          "hypothesis_id",
          "statement",
          "status",
          "supporting_evidence",
          "conflicting_evidence",
          "cost_spent",
          "decision",
          "rationale",
          "children",
          "updated_step"
        ],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "hypothesis_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["pending", "running", "supported", "weakened", "confounded", "boundary", "pruned", "merged"]
          },
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "conflicting_evidence": {"type": "array", "items": {"type": "string"}},
          "cost_spent": {"type": "integer", "minimum": 0},
          "decision": {"type": "string", "enum": ["none", "retain", "reject", "refine", "stop"]},
          "rationale": {"type": "string"},
          "children": {"type": "array", "items": {"type": "string"}},
          "updated_step": {"type": "integer", "minimum": 0}
        }
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "run_id",
          "branch_id",
          "action_id",
          "status",
          "step",
          "cost",
          "input_artifact_ids",
          "output_artifact_id",
          "inputs_path",
          "inputs_sha256",
          "result_path",
          "result_sha256",
          "completed_at"
        ],
        "properties": {
          "schema_version": {"const": "0.1"},
          "run_id": {"type": "string", "minLength": 1},
          "branch_id": {"type": "string", "minLength": 1},
          "action_id": {"type": "string", "minLength": 1},
          "status": {"const": "completed"},
          "step": {"type": "integer", "minimum": 1},
          "cost": {"type": "integer", "minimum": 1},
          "input_artifact_ids": {"type": "array", "items": {"type": "string"}},
          "output_artifact_id": {"type": "string", "minLength": 1},
          "inputs_path": {"type": "string", "minLength": 1},
          "inputs_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "result_path": {"type": "string", "minLength": 1},
          "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "completed_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
